# Django
DJANGO_SECRET_KEY=change-me-in-.env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (matches docker-compose.yml)
POSTGRES_DB=asartgroup
POSTGRES_USER=asartgroup
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://asartgroup:change-me@localhost:5432/asartgroup

# Redis (matches docker-compose.yml) — cache, sessions and API rate-limit counters
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# Performance tuning
DATABASE_CONN_MAX_AGE=60
CACHE_TTL_SETTINGS=300
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_CONTACT=5/hour

# Email — contact form notifications. Without EMAIL_HOST messages print to the
# console, so the flow works before real SMTP credentials exist.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=5
DEFAULT_FROM_EMAIL=AS-ART Group <noreply@as-artgroup.az>
# Empty = use the address from admin (SiteSettings.email)
CONTACT_NOTIFY_EMAIL=

# CORS (comma-separated origins allowed to call /api/v1/... — empty for now)
CORS_ALLOWED_ORIGINS=

# Production only (used when DJANGO_DEBUG=False)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://as-artgroup.az,https://www.as-artgroup.az

# AI provider keys — reserved for future use, unused today
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
