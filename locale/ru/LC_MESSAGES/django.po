#: contact/templates/contact/_section.html:6 templates/includes/dock.html:10
#: templates/includes/footer.html:47 templates/includes/topbar.html:14
msgid "Əlaqə"
msgstr "Контакты"

#: contact/templates/contact/_section.html:7
msgid "Növbəti şounuzu"
msgstr "Ваше следующее шоу"

#: contact/templates/contact/_section.html:7
msgid "birlikdə quraq"
msgstr "создадим вместе"

#: contact/templates/contact/_section.html:8
msgid ""
"Qısa brifinizi göndərin — 24 saat ərzində texniki rayder və təxmini büdcə "
"ilə qayıdaq."
msgstr "Отправьте короткий бриф — в течение 24 часов вернёмся с техническим райдером и сметой."

#: contact/templates/contact/_section.html:16
msgid "Zəhmət olmasa bütün sahələri doldurun."
msgstr "Пожалуйста, заполните все поля."

#: contact/templates/contact/_section.html:17
msgid "Email ünvanı düzgün görünmür."
msgstr "Адрес электронной почты выглядит некорректно."

#: contact/templates/contact/_section.html:18
msgid "Telefon nömrəsi düzgün görünmür. Nümunə: +994 50 000 00 00"
msgstr "Номер телефона выглядит некорректно. Пример: +994 50 000 00 00"

#: contact/templates/contact/_section.html:19
msgid "Göndərilir..."
msgstr "Отправляется..."

#: contact/templates/contact/_section.html:20
#, python-brace-format
msgid ""
"Təşəkkürlər, {name}! Sorğunuz qeydə alındı — 24 saat ərzində sizinlə əlaqə "
"saxlayacağıq."
msgstr "Спасибо, {name}! Заявка принята — мы свяжемся с вами в течение 24 часов."

#: contact/templates/contact/_section.html:21
msgid "Çox sayda sorğu göndərildi. Bir qədər sonra yenidən cəhd edin."
msgstr "Слишком много запросов. Попробуйте ещё раз чуть позже."

#: contact/templates/contact/_section.html:22
msgid "Göndərmək mümkün olmadı. Zəhmət olmasa yenidən cəhd edin."
msgstr "Не удалось отправить. Пожалуйста, попробуйте ещё раз."

#: contact/templates/contact/_section.html:23
msgid "Şəbəkə xətası. İnternet bağlantınızı yoxlayın."
msgstr "Ошибка сети. Проверьте подключение к интернету."

#: contact/templates/contact/_section.html:26
msgid "Ad və Soyad"
msgstr "Имя и фамилия"

#: contact/templates/contact/_section.html:27
msgid "Adınızı yazın"
msgstr "Введите ваше имя"

#: contact/templates/contact/_section.html:31
#: contact/templates/contact/_section.html:68
msgid "Email"
msgstr "Email"

#: contact/templates/contact/_section.html:35
#: contact/templates/contact/_section.html:64
msgid "Telefon"
msgstr "Телефон"

#: contact/templates/contact/_section.html:40
msgid "Mesaj"
msgstr "Сообщение"

#: contact/templates/contact/_section.html:41
msgid "Tədbirin növü, tarixi, məkanı və gözlənilən qonaq sayı..."
msgstr "Тип мероприятия, дата, место и ожидаемое количество гостей..."

#: contact/templates/contact/_section.html:44
msgid "Göndər"
msgstr "Отправить"

#: contact/templates/contact/_section.html:46
msgid ""
"Göndərməklə məlumatlarınızın yalnız bu sorğu üçün istifadəsinə razılıq "
"verirsiniz."
msgstr "Отправляя форму, вы соглашаетесь на использование данных только для этой заявки."

#: contact/templates/contact/_section.html:47
msgid ""
"Təşəkkürlər! Sorğunuz qeydə alındı — komandamız tezliklə sizinlə əlaqə "
"saxlayacaq."
msgstr "Спасибо! Заявка принята — наша команда скоро свяжется с вами."

#: contact/templates/contact/_section.html:53
msgid "Bakı xəritəsi"
msgstr "карта Баку"

#: contact/templates/contact/_section.html:60
msgid "Ofis"
msgstr "Офис"

#: contact/templates/contact/_section.html:72
msgid "İş saatları"
msgstr "Часы работы"

